# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Set spending limits on every API account below.

# --- LLM provider (used by Identify / Extract APIs) ---
# OpenAI-compatible proxy. Leave the key blank in the example; fill it in .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://apiclaude.cc/v1
# Vision-capable model used to build the product card.
IDENTIFY_MODEL=gpt-4o

# --- SERP provider (used by Search API) ---
# SerpApi (serpapi.com), Google Shopping engine. Leave blank to use the saved
# fixtures (scripts/fixtures/serp/*.json) instead of live calls.
SERP_API_KEY=
# Model for the Search API's match / normalise agents.
SEARCH_MODEL=gpt-4o
# Model for the Extract API's verification agents (C.2–C.5).
EXTRACT_MODEL=gpt-4o
# Countries to search by default (comma-separated ISO2). Blank = built-in subset.
SEARCH_COUNTRIES=

# --- Server ---
PORT=3000
NODE_ENV=development
